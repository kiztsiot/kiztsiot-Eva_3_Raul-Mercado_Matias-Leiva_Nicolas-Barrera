{
    "name": "techsolutions/gestion-proyectos",
    "type": "project",
    "description": "Sistema de Gestión de Proyectos - Tech Solutions",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "firebase/php-jwt": "^6.10",
        "laravel/sanctum": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "abandoned": "ignore"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
